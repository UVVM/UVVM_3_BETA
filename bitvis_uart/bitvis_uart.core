CAPI=2:
name: uvvm:uvvm:bitvis_uart:1.0.0
filesets:
  rtl:
    files:
    - ./src/uart_pkg.vhd
    - ./src/uart_pif_pkg.vhd
    - ./src/uart_pif.vhd
    - ./src/uart_core.vhd
    - ./src/uart.vhd
    file_type: vhdlSource-2008
    logical_name: bitvis_uart
  tb:
    files:
    - ./tb/uart_vvc_demo_th.vhd
    - ./tb/uart_vvc_demo_tb.vhd
    file_type: vhdlSource-2008
    logical_name: bitvis_uart
    depend:
    - uvvm:uvvm:bitvis_vip_clock_generator:1.0.0
    - uvvm:uvvm:bitvis_vip_sbi:1.0.0
    - uvvm:uvvm:bitvis_vip_uart:1.0.0
    - uvvm:uvvm:uvvm_util:1.0.0
    - uvvm:uvvm:uvvm_vvc_framework:1.0.0
targets:
  default:
    filesets:
    - rtl
  sim:
    filesets:
    - rtl
    - tb
    toplevel: bitvis_uart.uart_vvc_demo_tb
    default_tool: ghdl
    tools:
      ghdl:
        analyze_options:
        - -frelaxed
